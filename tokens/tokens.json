{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Causal-Lab 슬라이드 디자인 토큰. 이 파일이 단일 원본(source of truth)이며, `npm run tokens`로 tokens.css와 Marp 테마에 반영된다.",
  "color": {
    "brand": {
      "peach": {
        "$type": "color",
        "$value": "#F4B183",
        "$description": "커버 상단 밴드, 분할 바의 왼쪽 절반"
      },
      "blue": {
        "$type": "color",
        "$value": "#8FAADC",
        "$description": "커버 하단 밴드, 분할 바의 오른쪽 절반"
      },
      "navy": {
        "$type": "color",
        "$value": "#002060",
        "$description": "섹션 헤딩(밑줄), 강조 텍스트"
      },
      "logo": {
        "$type": "color",
        "$value": "#2E2A6E",
        "$description": "Causal-Lab 로고 배경 (참고용)"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#000000",
        "$description": "제목, 본문"
      },
      "muted": {
        "$type": "color",
        "$value": "#7F7F7F",
        "$description": "보조 문구, 페이지 번호, (Optional) 같은 주석"
      },
      "footer": {
        "$type": "color",
        "$value": "#595959",
        "$description": "하단 덱 이름"
      },
      "dim": {
        "$type": "color",
        "$value": "#C9D4EA",
        "$description": "포커스 슬라이드에서 흐리게 처리한 항목"
      },
      "link": {
        "$type": "color",
        "$value": "#0563C1"
      },
      "onBand": {
        "$type": "color",
        "$value": "#000000",
        "$description": "커버 하단 밴드 위 발표자 표기"
      }
    },
    "surface": {
      "page": {
        "$type": "color",
        "$value": "#FFFFFF"
      }
    },
    "table": {
      "border": {
        "$type": "color",
        "$value": "#4472C4"
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Pretendard",
          "Malgun Gothic",
          "Apple SD Gothic Neo",
          "Noto Sans KR",
          "Noto Sans CJK KR",
          "sans-serif"
        ],
        "$description": "슬라이드 제목. 굵기 800"
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Pretendard",
          "Malgun Gothic",
          "Apple SD Gothic Neo",
          "Noto Sans KR",
          "Noto Sans CJK KR",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500,
        "$description": "본문 기본"
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      },
      "heavy": {
        "$type": "fontWeight",
        "$value": 800,
        "$description": "제목, 섹션 헤딩"
      }
    },
    "size": {
      "coverTitle": {
        "$type": "dimension",
        "$value": "48px"
      },
      "coverSubtitle": {
        "$type": "dimension",
        "$value": "28px"
      },
      "presenter": {
        "$type": "dimension",
        "$value": "26px"
      },
      "title": {
        "$type": "dimension",
        "$value": "38px"
      },
      "section": {
        "$type": "dimension",
        "$value": "26px"
      },
      "body": {
        "$type": "dimension",
        "$value": "23px"
      },
      "table": {
        "$type": "dimension",
        "$value": "17px"
      },
      "pageNumber": {
        "$type": "dimension",
        "$value": "15px"
      },
      "footer": {
        "$type": "dimension",
        "$value": "10px"
      }
    },
    "lineHeight": {
      "body": {
        "$type": "number",
        "$value": 1.6
      }
    }
  },
  "size": {
    "slide": {
      "width": {
        "$type": "dimension",
        "$value": "1280px",
        "$description": "16:9"
      },
      "height": {
        "$type": "dimension",
        "$value": "720px"
      }
    },
    "padding": {
      "x": {
        "$type": "dimension",
        "$value": "52px"
      },
      "top": {
        "$type": "dimension",
        "$value": "28px"
      },
      "bottom": {
        "$type": "dimension",
        "$value": "56px"
      }
    },
    "accentBar": {
      "width": {
        "$type": "dimension",
        "$value": "24px",
        "$description": "제목 왼쪽 2색 블록 (peach | blue 각 절반)"
      },
      "height": {
        "$type": "dimension",
        "$value": "42px"
      }
    },
    "splitRule": {
      "contentWidth": {
        "$type": "dimension",
        "$value": "752px",
        "$description": "본문 슬라이드 제목 밑 2색 줄"
      },
      "contentHeight": {
        "$type": "dimension",
        "$value": "6px"
      },
      "coverWidth": {
        "$type": "dimension",
        "$value": "754px"
      },
      "coverHeight": {
        "$type": "dimension",
        "$value": "7px"
      }
    },
    "coverBand": {
      "top": {
        "$type": "dimension",
        "$value": "18.5%",
        "$description": "커버 상단 peach 밴드 높이"
      },
      "bottom": {
        "$type": "dimension",
        "$value": "18.5%",
        "$description": "커버 하단 blue 밴드 높이"
      }
    },
    "logo": {
      "content": {
        "$type": "dimension",
        "$value": "64px"
      },
      "cover": {
        "$type": "dimension",
        "$value": "74px"
      }
    },
    "list": {
      "indentSection": {
        "$type": "dimension",
        "$value": "118px",
        "$description": "섹션 헤딩(h2) 아래 ▪ 목록의 왼쪽 들여쓰기"
      }
    }
  }
}